        <NamedIndividual IRI="#7"/>
        <NamedIndividual IRI="#Overcoming_Worry"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="http://www.semanticweb.org/abbil/ontologies/2025/6/untitled-ontology-4#promotesVirtue"/>
        <NamedIndividual IRI="#7"/>
